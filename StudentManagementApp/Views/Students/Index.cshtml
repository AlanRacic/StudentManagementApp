@model IEnumerable<StudentManagementApp.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="mb-4">
    <h1 class="display-6 mb-2">Students and Grades</h1>
    <p class="text-muted mb-0">
        Overview of seeded student records and their associated grades.
    </p>
</div>

@foreach (var student in Model)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h4 mb-1">@student.StudentName</h2>
                    <div class="text-muted">
                        Born @student.DateOfBirth.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
                    </div>
                </div>

                <div class="text-md-end text-muted">
                    <div>
                        Height: @student.Height.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) m
                    </div>
                    <div>
                        Weight: @student.Weight.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) kg
                    </div>
                </div>
            </div>

            <h3 class="h6 text-uppercase text-muted mb-3">Grades</h3>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Subject</th>
                            <th scope="col">Grade</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var grade in student.Grades)
                        {
                            <tr>
                                <td>@grade.Section</td>
                                <td>
                                    <span class="badge text-bg-primary">
                                        @grade.GradeName
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}